# Reference for Lambda environment settings. Never put AWS secret keys here.
# The offline runner does not need or load this file.
# The SAM template supplies these values on a future authorized deployment.
AWS_DEFAULT_REGION=ap-southeast-1
USERS_TABLE=your-users-table
SCHOLARSHIPS_TABLE=your-scholarships-table
ACTIVITY_TABLE=your-activity-table
NOTIFICATIONS_TABLE=your-notifications-table
DOCUMENTS_TABLE=your-documents-table
DOCUMENT_BUCKET=your-private-document-bucket
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/your-pool-id
COGNITO_CLIENT_ID=your-public-client-id
