# Scholarship data remains the existing mock catalog. Authentication uses Cognito.
VITE_DISCOVERY_SOURCE=demo
# Optional loopback Python API for public discovery only:
# VITE_DISCOVERY_SOURCE=api
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional public discovery API (separate from authentication):
# VITE_API_BASE_URL=https://your-api-id.execute-api.your-region.amazonaws.com
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# Leave blank to use the current website origin + '/'.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
# Set only after a Cognito-protected /me API is configured and tested.
# Staff roles must come from this trusted backend, never browser storage.
VITE_ACCOUNT_API_BASE_URL=
