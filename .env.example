# Stage 2: public discovery and protected student APIs. Authentication remains Cognito.
VITE_DISCOVERY_SOURCE=api
VITE_API_BASE_URL=https://1wirfnp4a7.execute-api.ap-southeast-2.amazonaws.com
# Development fallback: set VITE_DISCOVERY_SOURCE=demo (API URL is then unused).
# Local Python API alternative: api + VITE_API_BASE_URL=http://127.0.0.1:8000
# AWS API use from localhost requires that origin to be allowed by backend CORS.
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# Leave blank to use the current website origin + '/'.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
# Stage 2 requires an existing, active UsersTable record matching the Cognito sub.
# Leave blank for the Stage 1/development fallback; never import local records.
# Staff roles must come from this trusted backend, never browser storage.
VITE_ACCOUNT_API_BASE_URL=https://1wirfnp4a7.execute-api.ap-southeast-2.amazonaws.com
