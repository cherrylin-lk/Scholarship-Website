{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "ScholarRise backend foundation. Review before any deployment. No resources are created by generating this file.",
  "Parameters": {
    "FrontendOrigin": {
      "Type": "String",
      "Default": "https://main.d1s9suck9hx25r.amplifyapp.com",
      "Description": "Exact HTTPS Amplify origin without trailing slash; loopback allowed for local development.",
      "AllowedPattern": "^https://[A-Za-z0-9.-]+$|^http://(localhost|127\\.0\\.0\\.1):5173$"
    },
    "ExistingUserPoolId": {
      "Type": "String",
      "Default": "ap-southeast-2_ONSDhlqBo",
      "AllowedValues": [
        "ap-southeast-2_ONSDhlqBo"
      ],
      "Description": "Existing ScholarRise pool in the deployment account and ap-southeast-2. Never created or updated by this stack."
    },
    "ExistingUserPoolClientId": {
      "Type": "String",
      "Default": "4tdlqbsg2jrr3qvbj5atjh7qig",
      "AllowedValues": [
        "4tdlqbsg2jrr3qvbj5atjh7qig"
      ],
      "Description": "Existing public SPA client. Existing managed-login settings remain unchanged."
    }
  },
  "Rules": {
    "SydneyOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-southeast-2"
            ]
          },
          "AssertDescription": "Deploy this existing-pool backend only in ap-southeast-2."
        }
      ]
    }
  },
  "Globals": {
    "Function": {
      "Runtime": "python3.13",
      "Architectures": [
        "x86_64"
      ],
      "MemorySize": 256,
      "Timeout": 20
    }
  },
  "Resources": {
    "UsersTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "ScholarshipsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "approvalStatus",
            "AttributeType": "S"
          },
          {
            "AttributeName": "ownerId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "StatusIndex",
            "KeySchema": [
              {
                "AttributeName": "approvalStatus",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "id",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "OwnerIndex",
            "KeySchema": [
              {
                "AttributeName": "ownerId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "id",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ]
      }
    },
    "ActivityTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "recordKey",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "recordKey",
            "KeyType": "RANGE"
          }
        ]
      }
    },
    "NotificationsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "userId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "id",
            "KeyType": "RANGE"
          }
        ]
      }
    },
    "DocumentsTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "DocumentBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "FrontendOrigin"
                }
              ],
              "AllowedMethods": [
                "GET",
                "POST"
              ],
              "AllowedHeaders": [
                "Content-Type"
              ],
              "MaxAge": 300
            }
          ]
        }
      }
    },
    "DocumentBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DocumentBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DocumentBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DocumentBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 14
      }
    },
    "ProvisionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-provision"
        },
        "RetentionInDays": 14
      }
    },
    "AccessLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ApplicationData",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-api:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Scan"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "UsersTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Scan"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ScholarshipsTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Query"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${ScholarshipsTable.Arn}/index/StatusIndex"
                    },
                    {
                      "Fn::Sub": "${ScholarshipsTable.Arn}/index/OwnerIndex"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ActivityTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "NotificationsTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "DocumentsTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DocumentBucket.Arn}/universities/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ProvisionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "StudentProvisioningOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-provision:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "UsersTable",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ProvisionFunction": {
      "Type": "AWS::Serverless::Function",
      "DependsOn": "ProvisionLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-provision"
        },
        "CodeUri": "../backend/",
        "Handler": "scholarrise.provision.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "ProvisionRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "USERS_TABLE": {
              "Ref": "UsersTable"
            }
          }
        }
      }
    },
    "ProvisionPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ProvisionFunction"
        },
        "Principal": "cognito-idp.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${ExistingUserPoolId}"
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "HttpApi": {
      "Type": "AWS::Serverless::HttpApi",
      "Properties": {
        "StageName": "$default",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Ref": "FrontendOrigin"
            }
          ],
          "AllowHeaders": [
            "authorization",
            "content-type"
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ],
          "MaxAge": 300
        },
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "AccessLogs",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"routeKey\":\"$context.routeKey\",\"status\":\"$context.status\",\"responseLength\":\"$context.responseLength\"}"
        },
        "Auth": {
          "DefaultAuthorizer": "CognitoJwt",
          "Authorizers": {
            "CognitoJwt": {
              "IdentitySource": "$request.header.Authorization",
              "JwtConfiguration": {
                "issuer": {
                  "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${ExistingUserPoolId}"
                },
                "audience": [
                  {
                    "Ref": "ExistingUserPoolClientId"
                  }
                ]
              },
              "AuthorizationScopes": [
                "openid"
              ]
            }
          }
        }
      }
    },
    "ApiFunction": {
      "Type": "AWS::Serverless::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "CodeUri": "../backend/",
        "Handler": "scholarrise.handler.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "ReservedConcurrentExecutions": 5,
        "Environment": {
          "Variables": {
            "USERS_TABLE": {
              "Ref": "UsersTable"
            },
            "SCHOLARSHIPS_TABLE": {
              "Ref": "ScholarshipsTable"
            },
            "ACTIVITY_TABLE": {
              "Ref": "ActivityTable"
            },
            "NOTIFICATIONS_TABLE": {
              "Ref": "NotificationsTable"
            },
            "DOCUMENTS_TABLE": {
              "Ref": "DocumentsTable"
            },
            "DOCUMENT_BUCKET": {
              "Ref": "DocumentBucket"
            },
            "COGNITO_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${ExistingUserPoolId}"
            },
            "COGNITO_CLIENT_ID": {
              "Ref": "ExistingUserPoolClientId"
            }
          }
        },
        "Events": {
          "Health": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "HttpApi"
              },
              "Path": "/health",
              "Method": "GET",
              "PayloadFormatVersion": "2.0",
              "Auth": {
                "Authorizer": "NONE"
              }
            }
          },
          "Search": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "HttpApi"
              },
              "Path": "/scholarships",
              "Method": "GET",
              "PayloadFormatVersion": "2.0",
              "Auth": {
                "Authorizer": "NONE"
              }
            }
          },
          "Detail": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "HttpApi"
              },
              "Path": "/scholarships/{id}",
              "Method": "GET",
              "PayloadFormatVersion": "2.0",
              "Auth": {
                "Authorizer": "NONE"
              }
            }
          },
          "Private": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "HttpApi"
              },
              "Path": "/{proxy+}",
              "Method": "ANY",
              "PayloadFormatVersion": "2.0"
            }
          }
        }
      }
    },
    "ApiErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Inspect CloudWatch when Lambda errors occur. No SNS integration.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "ApiFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "ApiHttpErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "HTTP API server errors, including handled Lambda 500 responses. No SNS action.",
        "Namespace": "AWS/ApiGateway",
        "MetricName": "5xx",
        "Dimensions": [
          {
            "Name": "ApiId",
            "Value": {
              "Ref": "HttpApi"
            }
          },
          {
            "Name": "Stage",
            "Value": "$default"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${HttpApi}.execute-api.${AWS::Region}.amazonaws.com"
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "ExistingUserPoolId"
      }
    },
    "UserPoolClientId": {
      "Value": {
        "Ref": "ExistingUserPoolClientId"
      }
    },
    "ProvisionFunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "ProvisionFunction",
          "Arn"
        ]
      },
      "Description": "Optional post-confirmation trigger: attach to the existing pool only after approval."
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "DocumentBucketName": {
      "Value": {
        "Ref": "DocumentBucket"
      }
    },
    "UsersTableName": {
      "Value": {
        "Ref": "UsersTable"
      }
    },
    "ScholarshipsTableName": {
      "Value": {
        "Ref": "ScholarshipsTable"
      }
    },
    "ActivityTableName": {
      "Value": {
        "Ref": "ActivityTable"
      }
    },
    "NotificationsTableName": {
      "Value": {
        "Ref": "NotificationsTable"
      }
    },
    "DocumentsTableName": {
      "Value": {
        "Ref": "DocumentsTable"
      }
    }
  }
}
